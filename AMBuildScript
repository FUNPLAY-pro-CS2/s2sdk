import os

# The build settings, split the same way as the CMake side (makefiles/cmake/):
# shared.ambuild <-> shared.cmake, linux.ambuild <-> linux.cmake,
# windows.ambuild <-> windows.cmake, AMBuilder <-> CMakeBuilder.cmake,
# package.ambuild <-> package.cmake, check.ambuild <-> check.cmake.
Shared = builder.Import('makefiles/ambuild/shared.ambuild')
Linux = builder.Import('makefiles/ambuild/linux.ambuild')
Windows = builder.Import('makefiles/ambuild/windows.ambuild')

class SDKConfig(object):
  def __init__(self):
    self.libs = []
    self.targets = []

    if builder.options.targets:
      target_archs = builder.options.targets.split(',')
    else:
      target_archs = ['x86_64']

    for arch in target_archs:
      cxx = builder.DetectCxx(target_arch = arch)
      self.targets.append(cxx)

  @property
  def tag(self):
    if builder.options.debug == '1':
      return 'Debug'
    return 'Release'

  # The manifests the SDK is checked against, the way plugins build against it
  @property
  def manifests(self):
    return builder.options.s2sdk_manifests or builder.options.hl2sdk_manifests

  def Platform(self, cxx):
    if cxx.target.platform == 'linux':
      return Linux
    if cxx.target.platform == 'windows':
      return Windows
    raise Exception('Unsupported target platform: {0}'.format(cxx.target.platform))

  def configure(self):
    # makefiles/ambuild/shared.ambuild, then linux.ambuild or windows.ambuild
    for cxx in self.targets:
      Shared.ConfigureCxx(cxx, builder.options)
      self.Platform(cxx).ConfigureCxx(cxx, builder.options)

  def ConfigureLibrary(self, project, compiler, context):
    binary = project.Configure(compiler, project.name, '{0} - {1}'.format(self.tag, compiler.target.arch))
    binary.compiler.cxxincludes += [
      os.path.join(context.sourcePath, 'public'),
      os.path.join(context.sourcePath, 'public', 'tier0'),
      os.path.join(context.sourcePath, 'public', 'tier1')
    ]
    return binary

HL2SDK = SDKConfig()
HL2SDK.configure()

BuildScripts = ['makefiles/ambuild/AMBuilder', 'makefiles/ambuild/package.ambuild']
if HL2SDK.manifests:
  BuildScripts += ['makefiles/ambuild/check.ambuild']
builder.Build(BuildScripts, { 'HL2SDK': HL2SDK })
