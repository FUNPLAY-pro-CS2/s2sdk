# vim: set ts=2 sw=2 tw=99 noet ft=python:
#
# What the SDK's own code (its libraries, the checks) is built with on every
# platform -- AMBuild twin of makefiles/cmake/shared.cmake. The per-platform
# part is in linux.ambuild / windows.ambuild.

def ConfigureCxx(cxx, options):
  # Optimization
  if options.opt == '1':
    cxx.defines += ['NDEBUG']

  # Debugging
  if options.debug == '1':
    cxx.defines += ['DEBUG', '_DEBUG']

  cxx.defines += ['X64BITS', 'PLATFORM_64BITS', '_LIB']
